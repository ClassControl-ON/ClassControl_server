# Salida de compilacion (se regenera con ant clean dist)
/build/
/tmp/

# Dependencias locales (JARs) - se resuelven en build
/lib/

# Archivos locales de NetBeans
/nbproject/private/

# Logs de crash de JVM y otros
*.log
*.zip

# Agentes locales de opencode
/.agents/
