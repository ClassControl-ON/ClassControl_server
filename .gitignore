# ClassControl backend - archivos que NO van al repositorio

# Salida de compilacion (se regenera con ant clean dist)
/build/
/tmp/

# Dependencias del proyecto: lib/ SI se versiona para que cualquiera
# pueda compilar solo con clonar el repositorio.

# Archivos locales de NetBeans (configuracion propia de cada maquina)
/nbproject/private/

# Logs de crash de JVM y otros
*.log
*.zip

# Agentes locales de opencode
/.agents/

# Archivos locales de IntelliJ IDEA
/.idea/
*.iml
